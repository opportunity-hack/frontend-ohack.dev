", "label": "Treasurer / admin", "pos": [40, 360], "size": [130, 60], "sublabel": "volunteer.admin (Jot Powers)", "type": "external"}, {"id": "admin-page", "label": "/admin/reimbursements", "pos": [230, 360], "size": [180, 64], "sources": [{"label": "admin list pattern", "path": "src/pages/admin/contact/index.js"}], "sublabel": "review table + detail dialog", "type": "frontend"}], "connections": [{"from": "submitter", "id": "submitter-to-page", "label": "files claim", "to": "public-page"}, {"from": "public-page", "fromSide": "top", "id": "page-to-recaptcha", "label": "verify human", "to": "recaptcha", "toSide": "bottom", "variant": "security"}, {"from": "public-page", "id": "page-to-backend", "label": "POST submit + mint URL, GET status", "to": "backend", "variant": "emphasis"}, {"from": "backend", "id": "backend-to-firestore", "label": "store claim", "to": "firestore"}, {"from": "backend", "fromSide": "bottom", "id": "backend-to-gcs", "label": "mint signed URL", "to": "gcs", "toSide": "top", "variant": "dashed"}, {"from": "reviewer", "id": "reviewer-to-admin", "label": "reviews claims", "to": "admin-page"}, {"from": "admin-page", "fromSide": "top", "id": "admin-to-backend", "label": "GET list + detail, PATCH review", "to": "backend", "toSide": "bottom", "variant": "emphasis"}], "diagram_type": "architecture", "meta": {"output": "docs/diagrams/reimbursement-20261116-0930/reimbursement-architecture.html", "quality_profile": "showcase", "repository": {"url": "https://github.com/opportunity-hack/frontend-ohack.dev.git", "revision": "c6d11f3d552caaa8afa3fc5e6c6e5dc3e0e37638"}, "title": "Reimbursement Requests: Frontend Architecture"}, "schema_version": 1}